# Required
ONYX_INGEST_URL=https://your-server.example.com/api/telemetry/ingest

# Optional auth
ONYX_INGEST_API_KEY=

# Optional metadata
ONYX_TOPOLOGY=enterprise_20n
ONYX_SOURCE=sysmon_forwarder
ONYX_SOURCE_NODE=LAPTOP-1
ONYX_TARGET_NODE=node_05_app

# Optional tuning
ONYX_POLL_SECONDS=5
ONYX_BATCH_SIZE=25
ONYX_PROTECTED_PORTS=22,80,443,445,3389,5432

# Optional local files
ONYX_STATE_PATH=tools/sysmon/forwarder_state.json
ONYX_IP_NODE_MAP_PATH=tools/sysmon/ip_to_node_map.json
