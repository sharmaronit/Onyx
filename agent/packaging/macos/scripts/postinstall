#!/bin/bash
set -euo pipefail
AGENT_DIR="/Library/Application Support/Onyx"
PLIST="/Library/LaunchDaemons/com.onyx.endpoint-agent.plist"
mkdir -p "$AGENT_DIR"
ARCH="$(uname -m)"
case "$ARCH" in
  arm64) SOURCE="$AGENT_DIR/bin/OnyxAgent-arm64" ;;
  x86_64) SOURCE="$AGENT_DIR/bin/OnyxAgent-x64" ;;
  *) echo "Unsupported Mac architecture: $ARCH" >&2; exit 1 ;;
esac
cp "$SOURCE" "$AGENT_DIR/OnyxAgent"
chown -R root:wheel "$AGENT_DIR"
chmod 700 "$AGENT_DIR"
chmod 755 "$AGENT_DIR/OnyxAgent"
chown root:wheel "$PLIST"
chmod 644 "$PLIST"
ln -sf "$AGENT_DIR/OnyxAgent" /usr/local/bin/onyx-agent
launchctl bootout system/com.onyx.endpoint-agent 2>/dev/null || true
launchctl bootstrap system "$PLIST"
exit 0
