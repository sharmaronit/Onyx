<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Onyx Endpoint Agent" Manufacturer="Onyx" Version="$(var.ProductVersion)" Language="1033" UpgradeCode="E8A6B1F8-47A9-45F0-87D1-1D5D0D7EF001">
    <MajorUpgrade DowngradeErrorMessage="A newer Onyx Endpoint Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Onyx">
        <Component Id="AgentExecutable" Guid="*" Bitness="always64">
          <File Id="OnyxAgentExe" Source="$(var.AgentExe)" KeyPath="yes" />
          <File Id="OnyxDesktopExe" Source="$(var.DesktopExe)">
            <Shortcut Id="OnyxDesktopStartMenu" Directory="ProgramMenuFolder" Name="Onyx Agent" WorkingDirectory="INSTALLFOLDER" Advertise="yes" />
          </File>
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="OnyxAgent" Type="string" Value="&quot;[#OnyxDesktopExe]&quot;" />
          <ServiceInstall Id="OnyxService" Name="OnyxEndpointAgent" DisplayName="Onyx Endpoint Agent" Description="Collects configured Onyx endpoint security telemetry over HTTPS." Start="auto" Type="ownProcess" Account="LocalSystem" ErrorControl="normal" Arguments="service" />
          <ServiceControl Id="OnyxServiceControl" Name="OnyxEndpointAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main" Title="Onyx Endpoint Agent" Level="1">
      <ComponentRef Id="AgentExecutable" />
    </Feature>
    <CustomAction Id="LaunchOnyxDesktop" FileRef="OnyxDesktopExe" ExeCommand="" Execute="immediate" Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchOnyxDesktop" After="InstallFinalize" Condition="NOT Installed AND UILevel &gt;= 4" />
    </InstallExecuteSequence>
  </Package>
</Wix>
