{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onyx Agent",
  "version": "1.1.1",
  "identifier": "com.onyx.endpoint-agent.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Onyx Agent", "width": 980, "height": 720, "minWidth": 720, "minHeight": 590, "center": true }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" } },
  "bundle": { "active": true, "targets": "all", "category": "Utility", "shortDescription": "Onyx endpoint status and enrollment", "longDescription": "Connects this laptop to an organization's Onyx endpoint security service." }
}
